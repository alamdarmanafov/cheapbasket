# Supabase (Project Settings → API). The anon key is safe to ship in the client; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Social providers enabled in Supabase → Auth → Providers (comma-separated). Add 'apple' after Apple setup.
EXPO_PUBLIC_AUTH_PROVIDERS=google,apple

# Admin/API deployment — the app calls <URL>/api/iap/verify after an App Store / Google Play purchase
EXPO_PUBLIC_API_URL=https://cheapbasket-7ae9.vercel.app

# Android only: Google Maps SDK for Android key (Google Cloud → APIs → Maps SDK for Android). iOS uses Apple Maps.
# For EAS builds: eas env:create --name GOOGLE_MAPS_ANDROID_KEY --value AIza... --visibility sensitive
GOOGLE_MAPS_ANDROID_KEY=
# iOS: Google Maps instead of Apple Maps (Maps SDK for iOS key). Leave empty to use Apple Maps.
GOOGLE_MAPS_IOS_KEY=
