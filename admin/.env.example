# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://khnctzbktybgcwkrfmhi.supabase.co
# service_role key — SERVER ONLY, never expose in the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin panel login (independent from app users). Several admins: comma-separated lists in the same order.
ADMIN_EMAIL=admin@cheapbasket.az
ADMIN_PASSWORD=change-me
# Random string used to sign the session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=change-me-too

# AI discount digest text (optional): OpenAI (preferred if set) or Anthropic; without either a template is used
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
# Vercel Cron authentication (any long random string; Vercel sends it as Bearer token)
CRON_SECRET=change-me
