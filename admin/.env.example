# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://khnctzbktybgcwkrfmhi.supabase.co
# service_role key — SERVER ONLY, never expose in the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin panel login (independent from app users). Several admins: comma-separated lists in the same order.
ADMIN_EMAIL=admin@cheapbasket.az
ADMIN_PASSWORD=change-me
# Random string used to sign the session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=change-me-too

# AI discount digest text (optional): OpenAI (preferred if set) or Anthropic; without either a template is used
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
# Vision model for "Məhsulun şəklini çək" (defaults to OPENAI_MODEL)
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
# Vercel Cron authentication (any long random string; Vercel sends it as Bearer token)
CRON_SECRET=change-me

# Apple in-app purchases (App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_IAP_KEY_ID=ABC123DEFG
APPLE_IAP_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Paste the whole .p8 file (multi-line values are fine in Vercel)
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID=az.cheapbasket.app

# Google Play in-app purchases (Google Cloud → service account with Play Console access; paste the JSON on one line)
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
GOOGLE_PLAY_PACKAGE=az.cheapbasket.app
